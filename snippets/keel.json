{
  "Agent": {
    "prefix": "agent",
    "body": [
      "agent ${1:Name} {",
      "  @on_start {",
      "    $0",
      "  }",
      "}",
      "",
      "run(${1:Name})"
    ],
    "description": "Declare an agent"
  },
  "Agent with state": {
    "prefix": "agents",
    "body": [
      "agent ${1:Name} {",
      "  state {",
      "    ${2:field}: ${3:int} = ${4:0}",
      "  }",
      "",
      "  @on_start {",
      "    $0",
      "  }",
      "}",
      "",
      "run(${1:Name})"
    ],
    "description": "Declare an agent with state"
  },
  "Agent with role, provider and model": {
    "prefix": "agentr",
    "body": [
      "agent ${1:Name} {",
      "  @role \"${2:You are a helpful assistant}\"",
      "  @provider ${3|ollama,openai,anthropic|}",
      "  @model \"${4:llama3}\"",
      "",
      "  @on_start {",
      "    $0",
      "  }",
      "}",
      "",
      "run(${1:Name})"
    ],
    "description": "Declare an agent with role, provider and model"
  },
  "Task": {
    "prefix": "task",
    "body": [
      "task ${1:name}(${2:param}: ${3:str}) -> ${4:str} {",
      "  $0",
      "}"
    ],
    "description": "Declare a task"
  },
  "Type (enum)": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = ${2:VariantA} | ${3:VariantB}"
    ],
    "description": "Declare an enum type"
  },
  "Type (struct)": {
    "prefix": "types",
    "body": [
      "type ${1:Name} {",
      "  ${2:field}: ${3:str}",
      "}"
    ],
    "description": "Declare a struct type"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "  task ${2:method}(${3:param}: ${4:str}) -> ${5:str}",
      "}"
    ],
    "description": "Declare an interface"
  },
  "@on_start": {
    "prefix": "on_start",
    "body": [
      "@on_start {",
      "  $0",
      "}"
    ],
    "description": "on_start lifecycle handler"
  },
  "@on_stop": {
    "prefix": "on_stop",
    "body": [
      "@on_stop {",
      "  $0",
      "}"
    ],
    "description": "on_stop lifecycle handler"
  },
  "on event handler": {
    "prefix": "on",
    "body": [
      "on ${1:event}(${2:msg}: ${3:str}) {",
      "  $0",
      "}"
    ],
    "description": "Declare an event handler"
  },
  "when expression": {
    "prefix": "when",
    "body": [
      "when ${1:value} {",
      "  ${2:VariantA} => $3",
      "  ${4:VariantB} => $5",
      "  _ => $0",
      "}"
    ],
    "description": "Pattern match with when"
  },
  "if/else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "  $2",
      "} else {",
      "  $0",
      "}"
    ],
    "description": "if/else block"
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:list} {",
      "  $0",
      "}"
    ],
    "description": "for loop"
  },
  "try/catch": {
    "prefix": "try",
    "body": [
      "try {",
      "  $1",
      "} catch ${2:err}: ${3:Error} {",
      "  $0",
      "}"
    ],
    "description": "try/catch block"
  },
  "ai.classify": {
    "prefix": "classify",
    "body": [
      "${1:result} = ai.classify(${2:input}, as: ${3:Type}) ?? ${4:Type.default}"
    ],
    "description": "Classify a value into an enum type"
  },
  "ai.summarize": {
    "prefix": "summarize",
    "body": [
      "${1:summary} = ai.summarize(${2:text})"
    ],
    "description": "Summarize text with the LLM"
  },
  "ai.prompt": {
    "prefix": "prompt",
    "body": [
      "${1:answer} = ai.prompt(system: \"${2:You are concise.}\", user: ${3:question}) ?? \"${4:no answer}\""
    ],
    "description": "Free-form LLM prompt"
  },
  "schedule.every": {
    "prefix": "every",
    "body": [
      "schedule.every(${1:1}.${2:hours}, () => {",
      "  $0",
      "})"
    ],
    "description": "Recurring schedule"
  },
  "schedule.cron": {
    "prefix": "cron",
    "body": [
      "schedule.cron(\"${1:0 9 * * 1-5}\", () => {",
      "  $0",
      "})"
    ],
    "description": "Cron schedule"
  },
  "use std module": {
    "prefix": "use",
    "body": [
      "use std/${1:ai}"
    ],
    "description": "Import a standard-library module"
  },
  "impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Interface} for ${2:Type} {",
      "  task ${3:method}(self, ${4:param}: ${5:str}) -> ${6:str} {",
      "    $0",
      "  }",
      "}"
    ],
    "description": "Implement an interface for a type"
  },
  "LLM provider": {
    "prefix": "provider",
    "body": [
      "type ${1:MyProvider} {}",
      "",
      "impl LlmProvider for ${1:MyProvider} {",
      "  task complete(self, req: CompletionRequest) -> str {",
      "    $0",
      "  }",
      "}",
      "",
      "ai.install(${1:MyProvider})"
    ],
    "description": "Author a custom LLM provider"
  },
  "while loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "  $0",
      "}"
    ],
    "description": "while loop"
  },
  "raise": {
    "prefix": "raise",
    "body": [
      "raise ${0:\"error message\"}"
    ],
    "description": "Raise an error"
  },
  "break": {
    "prefix": "break",
    "body": ["break"],
    "description": "Break out of a for loop"
  },
  "continue": {
    "prefix": "continue",
    "body": ["continue"],
    "description": "Continue to next loop iteration"
  },
  "for loop (range)": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:1}..${3:10} {",
      "  $0",
      "}"
    ],
    "description": "for loop over a range"
  },
  "for loop (filtered)": {
    "prefix": "forf",
    "body": [
      "for ${1:item} in ${2:list} if ${3:condition} {",
      "  $0",
      "}"
    ],
    "description": "for loop with filter guard"
  },
  "when (expression)": {
    "prefix": "whenx",
    "body": [
      "${1:result} = when ${2:value} {",
      "  ${3:VariantA} => $4",
      "  ${5:VariantB} => $6",
      "  _ => $0",
      "}"
    ],
    "description": "when expression assigned to a variable"
  },
  "Generic task": {
    "prefix": "taskg",
    "body": [
      "task ${1:name}[${2:T}](${3:x}: ${2:T}) -> ${4:T} {",
      "  $0",
      "}"
    ],
    "description": "Declare a generic task"
  },
  "Generic type (struct)": {
    "prefix": "typegs",
    "body": [
      "type ${1:Name}[${2:T}] {",
      "  ${3:items}: [${2:T}]",
      "  $0",
      "}"
    ],
    "description": "Declare a generic struct type"
  }
}
