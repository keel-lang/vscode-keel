{
  "name": "Keel",
  "scopeName": "source.keel",
  "patterns": [
    { "include": "#comments" },
    { "include": "#triple-strings" },
    { "include": "#strings" },
    { "include": "#duration-literals" },
    { "include": "#datetime-literals" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-control" },
    { "include": "#keywords-other" },
    { "include": "#constants" },
    { "include": "#prelude-namespaces" },
    { "include": "#builtin-functions" },
    { "include": "#function-calls" },
    { "include": "#type-names" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.keel",
      "match": "#.*$"
    },
    "triple-strings": {
      "name": "string.quoted.triple.keel",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.keel" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.keel" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.keel",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.keel" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.keel" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.keel",
      "match": "\\\\(?:[ntrfbv0\\\\\"{}]|u[0-9a-fA-F]{4})"
    },
    "string-interpolation": {
      "name": "meta.interpolation.keel",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.keel" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.interpolation.end.keel" } },
      "patterns": [{ "include": "source.keel" }]
    },
    "duration-literals": {
      "name": "constant.numeric.duration.keel",
      "match": "\\b([0-9]+)\\.(seconds|minutes|hours|days|weeks)\\b"
    },
    "datetime-literals": {
      "name": "constant.other.datetime.keel",
      "match": "@(?:[0-9]{4}-[0-9]{2}-[0-9]{2}(?:[T ][0-9:.+Zz-]+)?|(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)[a-z0-9_]*)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.keel",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.keel",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "attributes": {
      "name": "entity.other.attribute-name.keel",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "keywords-declaration": {
      "name": "keyword.declaration.keel",
      "match": "\\b(agent|task|interface|impl|type|extern|use|from|state|on|set)\\b"
    },
    "keywords-control": {
      "name": "keyword.control.keel",
      "match": "\\b(if|else|when|where|for|while|in|try|catch|return|raise|break|continue)\\b"
    },
    "keywords-other": {
      "name": "keyword.other.keel",
      "match": "\\b(as|and|or|not)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.keel",
          "match": "\\b(true|false|none)\\b"
        },
        {
          "name": "variable.language.keel",
          "match": "\\bself\\b"
        }
      ]
    },
    "prelude-namespaces": {
      "name": "support.class.keel",
      "match": "\\b(ai|async|cache|control|crypto|csv|db|email|env|file|http|io|json|log|math|memory|random|schedule|search|shell|testing|time|uuid)\\b(?=\\.)"
    },
    "builtin-functions": {
      "name": "support.function.builtin.keel",
      "match": "\\b(run|stop|send|delegate|broadcast|min|max|typeof)\\b(?=\\s*\\()"
    },
    "function-calls": {
      "name": "entity.name.function.keel",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    },
    "type-names": {
      "patterns": [
        {
          "name": "storage.type.builtin.keel",
          "match": "\\b(str|int|float|bool|duration|datetime|dynamic)\\b"
        },
        {
          "name": "entity.name.type.keel",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.keel",
          "match": "=>|->|\\|>|==|!=|<=|>=|\\?\\?|\\?\\.|!\\.|\\+=|-=|\\*=|/=|%=|\\.\\."
        },
        {
          "name": "keyword.operator.keel",
          "match": "[+\\-*/%<>=!?|]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.keel",
          "match": "[,;]"
        },
        {
          "name": "punctuation.separator.key-value.keel",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.keel",
      "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
    }
  }
}
